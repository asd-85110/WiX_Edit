<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="WiX_Edit" />
		<Option pch_mode="2" />
		<Option compiler="gcc-mingw64" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/WiX_Edit" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc-mingw64" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-D__WXDEBUG__" />
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="libwxmsw32ud_webview.a" />
					<Add library="libwxmsw32ud_stc.a" />
					<Add library="libwxmsw32ud_aui.a" />
					<Add library="libwxbase32ud_xml.a" />
					<Add library="libwxmsw32ud_core.a" />
					<Add library="libwxbase32ud.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/WiX_Edit" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc-mingw64" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add library="libwxmsw32u_webview.a" />
					<Add library="libwxmsw32u_stc.a" />
					<Add library="libwxmsw32u_aui.a" />
					<Add library="libwxbase32u_xml.a" />
					<Add library="libwxmsw32u_core.a" />
					<Add library="libwxbase32u.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add directory="$(#wx)/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx)/include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
		</Linker>
		<Unit filename="WiX_EditApp.cpp" />
		<Unit filename="WiX_EditApp.hpp" />
		<Unit filename="WiX_EditMain.cpp" />
		<Unit filename="WiX_EditMain.hpp" />
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Extensions>
			<DoxyBlocks>
				<comment_style block="0" line="2" />
				<doxyfile_project project_number="1" output_language="" />
				<doxyfile_build />
				<doxyfile_warnings />
				<doxyfile_output />
				<doxyfile_dot />
				<general />
			</DoxyBlocks>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
